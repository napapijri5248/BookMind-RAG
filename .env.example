# LLM & API Configuration Example
# Replace with your actual credentials in a local .env file

# Groq API Key (Optional / for Groq inference)
GROQ_API_KEY=your_groq_api_key_here

# Ollama Cloud API Key (Optional / for cloud endpoints)
OLLAMA_API_KEY=your_ollama_api_key_here

# HuggingFace Token (Optional / for hosted models)
HUGGINGFACEHUB_API_TOKEN=your_huggingface_token_here
